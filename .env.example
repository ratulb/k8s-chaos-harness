# Ollama / Kaggle
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_API_KEY=ollama

# Hosted fallbacks
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Kaggle tunnel
ZROK_TOKEN=
PUBLIC_KEY_URL=https://raw.githubusercontent.com/ratulb/tenmo/refs/heads/main/pub_id
MODEL=qwen3.8:27b

# Cluster access. Leave K8S_NODES empty to discover names with kubectl.
# K8S_NODES=node-a,node-b,node-c
# K8S_NODE_IPS=node-a=10.0.0.1,node-b=10.0.0.2,node-c=10.0.0.3
SSH_USER=
SSH_KEY=
# Optional override for the etcd probe node (default: first discovered node).
PROBE_NODE=
