# Authoritative run store (stdlib sqlite3; no extra dependency)
CHECKPOINT_DB=results.sqlite3

# Self-hosted ollama backend (local or tunneled; no live endpoint needed for offline tests)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_API_KEY=ollama

# Hosted baseline backends (selected per run; no automatic fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional tunnel infrastructure for a self-hosted ollama endpoint
ZROK_TOKEN=
PUBLIC_KEY_URL=https://raw.githubusercontent.com/ratulb/tenmo/refs/heads/main/pub_id
MODEL=qwen3.8:27b

# Cluster access. Leave K8S_NODES empty to discover names with kubectl.
K8S_EASY_INSTALL=$HOME/k8s-easy-install
# K8S_NODES=node-a,node-b,node-c
# K8S_NODE_IPS=node-a=10.0.0.1,node-b=10.0.0.2,node-c=10.0.0.3
SSH_USER=
SSH_KEY=
# Optional override for the etcd probe node (default: first discovered node).
PROBE_NODE=

# Destructive run guard. Set one of the context/ID allow-lists before ./chaos run.
# CHAOS_ALLOWED_CLUSTER_CONTEXTS=lab-context
# CHAOS_CLUSTER_ID=lab-cluster
# CHAOS_ALLOWED_CLUSTER_IDS=lab-cluster
# CHAOS_ALLOWED_TOPOLOGY_HASHES=<hash from ./chaos target show --json>
