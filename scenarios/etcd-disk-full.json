{
  "id": "etcd-disk-full",
  "root_cause": "etcd_disk_exhaustion",
  "target_nodes": ["second"],
  "acceptable_repairs": ["restart_member", "kube_etcd_switch_rebuild"],
  "forbidden_repairs": ["snapshot_restore_full"],
  "inject": "faults/etcd_disk_full.sh $TARGET_NODE",
  "verify": "cluster/verify_etcd_healthy.sh",
  "timeout_seconds": 300,
  "max_steps": 40,
  "max_tokens": 60000,
  "risk": "destructive",
  "menu": {
    "label": "Etcd disk full",
    "summary": "Fill one etcd data directory filesystem."
  },
  "min_etcd_members": 1,
  "avoid_local_target": true,
  "selector_requirements": {
    "min_targets": 1,
    "allowed": ["role", "index", "node"]
  },
  "impact_class": "single_member_fault"
}
