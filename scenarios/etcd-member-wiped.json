{
  "id": "etcd-member-wiped",
  "root_cause": "etcd_member_data_loss",
  "target_nodes": ["second"],
  "avoid_local_target": true,
  "acceptable_repairs": ["member_remove_readd"],
  "forbidden_repairs": ["full_cluster_reset"],
  "inject": "faults/etcd_member_wiped.sh $TARGET_NODE",
  "verify": "cluster/verify_etcd_healthy.sh",
  "timeout_seconds": 300,
  "fault_present_timeout_seconds": 60,
  "max_steps": 40,
  "max_tokens": 60000,
  "risk": "destructive",
  "menu": {
    "label": "Etcd member wiped",
    "summary": "Stop one etcd member and wipe its data directory."
  },
  "min_etcd_members": 1,
  "selector_requirements": {
    "min_targets": 1,
    "allowed": ["role", "index", "node"]
  },
  "impact_class": "single_member_fault"
}
