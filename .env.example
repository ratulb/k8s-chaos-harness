# Authoritative run store (stdlib sqlite3; no extra dependency)
CHECKPOINT_DB=results.sqlite3

# FIRST: configure at least one working LLM endpoint/key. This is the agent brain.
# `./chaos ping` uses the fallback chain and needs no Kubernetes cluster.
# Self-hosted ollama backend (local or tunneled; no live endpoint needed for offline tests)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_API_KEY=ollama

# Hosted baseline backends. All configured endpoints join the fallback chain.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional: arbitrary OpenAI-compatible endpoints, as many as needed.
# Names become valid --backend values and `auto` uses priority order.
# CHAOS_LLM_ENDPOINTS=[{"name":"gpu","base_url":"http://127.0.0.1:11435","model":"qwen3.8:27b","priority":1},{"name":"backup","base_url":"https://api.example.com/v1","model":"small","api_key_env":"BACKUP_API_KEY","priority":2}]
# CHAOS_LLM_FALLBACK=1
# CHAOS_LLM_FALLBACK_RETRIES=0
# CHAOS_LLM_HEALTH_SORT=1
# CHAOS_LLM_MAX_ATTEMPTS=0


# Cluster access. Leave K8S_NODES empty to discover names with kubectl.
K8S_EASY_INSTALL=$HOME/k8s-easy-install
# K8S_NODES=node-a,node-b,node-c
# K8S_NODE_IPS=node-a=10.0.0.1,node-b=10.0.0.2,node-c=10.0.0.3
SSH_USER=
SSH_KEY=
# Optional override for the etcd probe node (default: frozen topology probe node).
PROBE_NODE=
# Seconds to wait for an etcd pod to become ready after restart_member (default: 180).
# CHAOS_REPAIR_READY_TIMEOUT=180

# Destructive run guard. Set either the context or the ID allow-list before ./chaos run.
# CHAOS_ALLOWED_CLUSTER_CONTEXTS=lab-context
# CHAOS_CLUSTER_ID=lab-cluster
# CHAOS_ALLOWED_CLUSTER_IDS=lab-cluster
# Optional; checked only when set.
# CHAOS_ALLOWED_TOPOLOGY_HASHES=<hash from ./chaos target show --json>
# Offline topology tests only; never set this against a live cluster.
# CHAOS_ALLOW_FIXTURE_RUNS=1
